# KnowCode environment variables
#
# Copy this file to `.env` and fill in real values, or export the variables
# directly in your shell. `.env` is gitignored and should never be committed.
#
# KnowCode runs retrieval 100% locally. These keys are only needed for the
# optional LLM/embedding/reranking features (the `llm`, `search`, `voyageai`
# extras). Run `knowcode doctor` to check which keys are missing for your setup.
#
# Model selection is driven by aimodels.yaml; each model entry has an
# `api_key_env` field naming the variable below that holds its key.

# --- The LiteLLM proxy, for chat (`ask`) and embeddings (semantic search) -----
# The key the proxy authenticates callers with. GLM chat and voyage embeddings
# go to the proxy, which holds the provider keys itself, so the shipped
# aimodels.yaml names this variable for both. The proxy rejects a provider key
# with `400 No connected db`.
LITELLM_MASTER_KEY=

# Address override for the LiteLLM proxy that GLM/z-ai chat traffic targets.
# Leave empty to use the default proxy address http://127.0.0.1:4000.
GLM_BASE_URL=

# Address override for the proxy that voyage embeddings target. Leave empty to
# use the default proxy address http://127.0.0.1:4000.
VOYAGE_BASE_URL=

# --- Cross-encoder reranking (hybrid retrieval) --------------------------------
# VoyageAI key for the reranker, configured under `reranking_models` in
# aimodels.yaml. Unlike chat and embeddings, reranking still calls VoyageAI
# directly (BL-44 in docs/engineering/backlog.md).
VOYAGE_API_KEY_1=

# --- Optional alternative provider --------------------------------------------
# Google Gemini key (default for a `google`-provider model entry). Only required
# if an aimodels.yaml entry uses api_key_env: GOOGLE_API_KEY.
GOOGLE_API_KEY=

# KNOWCODE_TELEMETRY_RAW=1  # opt in to raw local query capture (docs/user/telemetry.md)

# --- Internal / test-only (do NOT set in normal use) --------------------------
# Set to "1" to mark the process as running under the test suite; telemetry
# writes then run synchronously instead of on the background pool, keeping
# tests deterministic. Nothing is suppressed. Not needed for development or
# production use.
# KNOWCODE_TESTING=
