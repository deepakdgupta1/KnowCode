# KnowCode environment variables
#
# Copy this file to `.env` and fill in real values, or export the variables
# directly in your shell. `.env` is gitignored and should never be committed.
#
# KnowCode runs retrieval 100% locally. These keys are only needed for the
# optional LLM/embedding/reranking features (the `llm`, `search`, `voyageai`
# extras). Run `knowcode doctor` to check which keys are missing for your setup.
#
# Model selection is driven by aimodels.yaml; each model entry has an
# `api_key_env` field naming the variable below that holds its key.

# --- Chat / completion (NL Q&A via the `ask` command and API) ------------------
# OpenAI-compatible provider for the natural-language agent. Configured under the
# `nl` group in aimodels.yaml. Default provider in the shipped config is GLM.
GLM_API_KEY=

# Base URL override for OpenAI-compatible providers (e.g. a GLM/Z.AI gateway).
# Leave empty to use the provider's default endpoint.
GLM_BASE_URL=

# --- Embeddings & cross-encoder reranking (semantic search + hybrid retrieval) -
# VoyageAI key used for voyage-code-3 embeddings and the reranker.
# Configured under the `embedding` and `reranker` groups in aimodels.yaml.
VOYAGE_API_KEY_1=

# --- Optional alternative provider --------------------------------------------
# Google Gemini key (default for a `google`-provider model entry). Only required
# if an aimodels.yaml entry uses api_key_env: GOOGLE_API_KEY.
GOOGLE_API_KEY=

# --- Internal / test-only (do NOT set in normal use) --------------------------
# Set to "1" to mark the process as running under the test suite; suppresses
# telemetry writes. Not needed for development or production use.
# KNOWCODE_TESTING=
